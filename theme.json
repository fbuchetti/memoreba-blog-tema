{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "base",
          "color": "#FFFFFF",
          "name": "Branco"
        },
        {
          "slug": "contrast",
          "color": "#232B2B",
          "name": "Grafite"
        },
        {
          "slug": "contrast-2",
          "color": "#6B7272",
          "name": "Grafite claro"
        },
        {
          "slug": "contrast-3",
          "color": "#E6E8E8",
          "name": "Linha"
        },
        {
          "slug": "metodo",
          "color": "#20A8E0",
          "name": "Método (ciano)"
        },
        {
          "slug": "memoria",
          "color": "#844890",
          "name": "Memória (roxo)"
        },
        {
          "slug": "edital",
          "color": "#E46C30",
          "name": "Edital (laranja)"
        },
        {
          "slug": "rotina",
          "color": "#009C9C",
          "name": "Rotina (teal)"
        },
        {
          "slug": "bastidores",
          "color": "#FCB418",
          "name": "Bastidores (amarelo)"
        },
        {
          "slug": "especial",
          "color": "#E41860",
          "name": "Série especial (magenta)"
        }
      ]
    }
  },
  "customTemplates": [
    {
      "name": "pagina-guia",
      "title": "Página do Guia (com navegação lateral)",
      "postTypes": ["page"]
    }
  ],
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--metodo)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--contrast)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--contrast)",
          "text": "var(--wp--preset--color--base)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--metodo)",
            "text": "var(--wp--preset--color--base)"
          }
        }
      },
      "h1": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "h2": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "h3": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              }
            }
          }
        }
      },
      "core/post-title": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--metodo)"
              }
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var(--wp--preset--color--contrast-2)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast-2)"
            }
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--contrast-3)"
        }
      }
    }
  }
}
